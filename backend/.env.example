# Copy to .env and fill in. mvn spring-boot:run / docker run will not
# auto-load this file — export the variables (or use a tool like `dotenv`)
# before starting the app, or pass them as -D system properties / Render
# environment variables in production.

DB_URL=jdbc:postgresql://localhost:5433/ticketbooking
DB_USERNAME=ticketbooking
DB_PASSWORD=ticketbooking

REDIS_URL=redis://localhost:6379

HOLD_TTL_MINUTES=10

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
